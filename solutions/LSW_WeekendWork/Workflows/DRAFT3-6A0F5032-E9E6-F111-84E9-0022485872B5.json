{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "impersonation": {},
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "lsw_weekendwork_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_sharepointonline": {
        "impersonation": {},
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "lsw_weekendwork_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_approvals": {
        "impersonation": {},
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "lsw_weekendwork_approvals"
        },
        "api": {
          "name": "shared_approvals"
        }
      },
      "shared_office365": {
        "impersonation": {},
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "lsw_weekendwork_outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "RowAdded": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "lsw_tb_weekendworkrequest",
              "subscriptionRequest/scope": 4
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@equals(triggerBody()?['lsw_approvalstatus'],'Pending')"
            }
          ]
        }
      },
      "actions": {
        "GetEmployee": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem"
            },
            "parameters": {
              "entityName": "lsw_tb_employee_weekendworks",
              "recordId": "@triggerBody()?['_lsw_employee_value']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "EmailReceived": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "parameters": {
              "emailMessage/To": "@outputs('GetEmployee')?['body/lsw_emp_email']",
              "emailMessage/Subject": "[Weekend Work] Request received",
              "emailMessage/Body": "<p>Your weekend work request was received. We will send the approval result.</p>"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "GetEmployee": [
              "Succeeded"
            ]
          }
        },
        "GetApplicantRows": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://dexconsultingnet.sharepoint.com/sites/Orgnization_Char",
              "table": "{{SHAREPOINT_LIST_ID_OR_NAME}}",
              "$filter": "@concat('{{USER_EMAIL_INTERNAL_FIELD}} eq ''',replace(outputs('GetEmployee')?['body/lsw_emp_email'],'''',''''''),'''')",
              "$top": 100
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "EmailReceived": [
              "Succeeded"
            ]
          }
        },
        "FilterMemberRows": {
          "type": "Query",
          "inputs": {
            "from": "@outputs('GetApplicantRows')?['body/value']",
            "where": "@and(equals(toLower(coalesce(item()?['{{USER_EMAIL_INTERNAL_FIELD}}'],'')),toLower(outputs('GetEmployee')?['body/lsw_emp_email'])),endsWith(trim(coalesce(item()?['{{NAME_INTERNAL_FIELD}}'],'')),' 팀원'))"
          },
          "runAfter": {
            "GetApplicantRows": [
              "Succeeded"
            ]
          }
        },
        "IfUniqueMember": {
          "type": "If",
          "expression": {
            "equals": [
              "@length(body('FilterMemberRows'))",
              1
            ]
          },
          "actions": {
            "TeamName": {
              "type": "Compose",
              "inputs": "@trim(replace(first(body('FilterMemberRows'))?['{{NAME_INTERNAL_FIELD}}'],' 팀원',''))",
              "runAfter": {}
            },
            "GetLeaderRows": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "https://dexconsultingnet.sharepoint.com/sites/Orgnization_Char",
                  "table": "{{SHAREPOINT_LIST_ID_OR_NAME}}",
                  "$filter": "@concat('{{NAME_INTERNAL_FIELD}} eq ''',replace(concat(outputs('TeamName'),' Leader'),'''',''''''),'''')",
                  "$top": 100
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "TeamName": [
                  "Succeeded"
                ]
              }
            },
            "FilterLeaders": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('GetLeaderRows')?['body/value']",
                "where": "@and(equals(trim(coalesce(item()?['{{NAME_INTERNAL_FIELD}}'],'')),concat(outputs('TeamName'),' Leader')),not(empty(item()?['{{USER_EMAIL_INTERNAL_FIELD}}'])))"
              },
              "runAfter": {
                "GetLeaderRows": [
                  "Succeeded"
                ]
              }
            },
            "IfUniqueLeader": {
              "type": "If",
              "expression": {
                "equals": [
                  "@length(body('FilterLeaders'))",
                  1
                ]
              },
              "actions": {
                "LeaderEmail": {
                  "type": "Compose",
                  "inputs": "@first(body('FilterLeaders'))?['{{USER_EMAIL_INTERNAL_FIELD}}']",
                  "runAfter": {}
                },
                "IfSelfApprover": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@toLower(outputs('LeaderEmail'))",
                      "@toLower(outputs('GetEmployee')?['body/lsw_emp_email'])"
                    ]
                  },
                  "actions": {
                    "SetRoutingErrorSelfApproval": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateRecord"
                        },
                        "parameters": {
                          "entityName": "lsw_tb_weekendworkrequests",
                          "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                          "item/lsw_approvalstatus": "RoutingError",
                          "item/lsw_flowerror": "Stage 1 leader equals applicant; policy decision required"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    },
                    "EmailRoutingErrorSelfApproval": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2"
                        },
                        "parameters": {
                          "emailMessage/To": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                          "emailMessage/Subject": "[Weekend Work] Approver review required",
                          "emailMessage/Body": "<p>We received the request, but could not resolve an approver. Contact an administrator.</p>"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "SetRoutingErrorSelfApproval": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "SetStage1": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "UpdateRecord"
                          },
                          "parameters": {
                            "entityName": "lsw_tb_weekendworkrequests",
                            "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                            "item/lsw_approvalstatus": "Pending",
                            "item/lsw_currentstage": 1,
                            "item/lsw_stage1approveremail": "@outputs('LeaderEmail')",
                            "item/lsw_department": "@outputs('TeamName')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      },
                      "Approval1": {
                        "type": "OpenApiConnectionWebhook",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                            "connectionName": "shared_approvals",
                            "operationId": "StartAndWaitForAnApproval"
                          },
                          "parameters": {
                            "approvalType": "CustomResponseAwaitAll",
                            "WebhookApprovalCreationInput/responseOptions": [
                              "승인",
                              "거부"
                            ],
                            "WebhookApprovalCreationInput/title": "[주말근무 1차 승인] @{triggerBody()?['lsw_requestname']}",
                            "WebhookApprovalCreationInput/assignedTo": "@outputs('LeaderEmail')",
                            "WebhookApprovalCreationInput/details": "신청자: @{outputs('GetEmployee')?['body/lsw_emp_name']}\n근무일: @{triggerBody()?['lsw_workdate']}\n프로젝트: @{triggerBody()?['lsw_projectname']}\n신청 사유: @{triggerBody()?['lsw_reason']}",
                            "WebhookApprovalCreationInput/requestor": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                            "WebhookApprovalCreationInput/enableNotifications": true,
                            "WebhookApprovalCreationInput/enableReassignment": true
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {
                          "SetStage1": [
                            "Succeeded"
                          ]
                        }
                      },
                      "IfStage1Approved": {
                        "type": "If",
                        "expression": {
                          "equals": [
                            "@outputs('Approval1')?['body/outcome']",
                            "승인"
                          ]
                        },
                        "actions": {
                          "SetStage2": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "UpdateRecord"
                              },
                              "parameters": {
                                "entityName": "lsw_tb_weekendworkrequests",
                                "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                                "item/lsw_stage1result": "Approved",
                                "item/lsw_currentstage": 2,
                                "item/lsw_stage2approveremail": "{{STAGE2_EMAIL}}"
                              },
                              "authentication": "@parameters('$authentication')"
                            },
                            "runAfter": {}
                          },
                          "Approval2": {
                            "type": "OpenApiConnectionWebhook",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                                "connectionName": "shared_approvals",
                                "operationId": "StartAndWaitForAnApproval"
                              },
                              "parameters": {
                                "approvalType": "CustomResponseAwaitAll",
                                "WebhookApprovalCreationInput/responseOptions": [
                                  "승인",
                                  "거부"
                                ],
                                "WebhookApprovalCreationInput/title": "[주말근무 2차 승인] @{triggerBody()?['lsw_requestname']}",
                                "WebhookApprovalCreationInput/assignedTo": "{{STAGE2_EMAIL}}",
                                "WebhookApprovalCreationInput/details": "신청자: @{outputs('GetEmployee')?['body/lsw_emp_name']}\n근무일: @{triggerBody()?['lsw_workdate']}\n프로젝트: @{triggerBody()?['lsw_projectname']}\n신청 사유: @{triggerBody()?['lsw_reason']}",
                                "WebhookApprovalCreationInput/requestor": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                                "WebhookApprovalCreationInput/enableNotifications": true,
                                "WebhookApprovalCreationInput/enableReassignment": true
                              },
                              "authentication": "@parameters('$authentication')"
                            },
                            "runAfter": {
                              "SetStage2": [
                                "Succeeded"
                              ]
                            }
                          },
                          "IfStage2Approved": {
                            "type": "If",
                            "expression": {
                              "equals": [
                                "@outputs('Approval2')?['body/outcome']",
                                "승인"
                              ]
                            },
                            "actions": {
                              "SetStage3": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                    "connectionName": "shared_commondataserviceforapps",
                                    "operationId": "UpdateRecord"
                                  },
                                  "parameters": {
                                    "entityName": "lsw_tb_weekendworkrequests",
                                    "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                                    "item/lsw_stage2result": "Approved",
                                    "item/lsw_currentstage": 3,
                                    "item/lsw_stage3approveremail": "{{STAGE3_EMAIL}}"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                },
                                "runAfter": {}
                              },
                              "Approval3": {
                                "type": "OpenApiConnectionWebhook",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                                    "connectionName": "shared_approvals",
                                    "operationId": "StartAndWaitForAnApproval"
                                  },
                                  "parameters": {
                                    "approvalType": "CustomResponseAwaitAll",
                                    "WebhookApprovalCreationInput/responseOptions": [
                                      "승인",
                                      "거부"
                                    ],
                                    "WebhookApprovalCreationInput/title": "[주말근무 3차 승인] @{triggerBody()?['lsw_requestname']}",
                                    "WebhookApprovalCreationInput/assignedTo": "{{STAGE3_EMAIL}}",
                                    "WebhookApprovalCreationInput/details": "신청자: @{outputs('GetEmployee')?['body/lsw_emp_name']}\n근무일: @{triggerBody()?['lsw_workdate']}\n프로젝트: @{triggerBody()?['lsw_projectname']}\n신청 사유: @{triggerBody()?['lsw_reason']}",
                                    "WebhookApprovalCreationInput/requestor": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                                    "WebhookApprovalCreationInput/enableNotifications": true,
                                    "WebhookApprovalCreationInput/enableReassignment": true
                                  },
                                  "authentication": "@parameters('$authentication')"
                                },
                                "runAfter": {
                                  "SetStage3": [
                                    "Succeeded"
                                  ]
                                }
                              },
                              "IfStage3Approved": {
                                "type": "If",
                                "expression": {
                                  "equals": [
                                    "@outputs('Approval3')?['body/outcome']",
                                    "승인"
                                  ]
                                },
                                "actions": {
                                  "ApproveRequest": {
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                        "connectionName": "shared_commondataserviceforapps",
                                        "operationId": "UpdateRecord"
                                      },
                                      "parameters": {
                                        "entityName": "lsw_tb_weekendworkrequests",
                                        "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                                        "item/lsw_approvalstatus": "Approved",
                                        "item/lsw_currentstage": 3,
                                        "item/lsw_stage3result": "Approved",
                                        "item/lsw_processedby": "{{STAGE3_EMAIL}}"
                                      },
                                      "authentication": "@parameters('$authentication')"
                                    },
                                    "runAfter": {}
                                  },
                                  "EmailApproved": {
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                        "connectionName": "shared_office365",
                                        "operationId": "SendEmailV2"
                                      },
                                      "parameters": {
                                        "emailMessage/To": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                                        "emailMessage/Subject": "[주말근무 신청] 최종 승인",
                                        "emailMessage/Body": "<p>주말근무 신청이 최종 승인되었습니다.</p>"
                                      },
                                      "authentication": "@parameters('$authentication')"
                                    },
                                    "runAfter": {
                                      "ApproveRequest": [
                                        "Succeeded"
                                      ]
                                    }
                                  }
                                },
                                "else": {
                                  "actions": {
                                    "RejectStage3": {
                                      "type": "OpenApiConnection",
                                      "inputs": {
                                        "host": {
                                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                          "connectionName": "shared_commondataserviceforapps",
                                          "operationId": "UpdateRecord"
                                        },
                                        "parameters": {
                                          "entityName": "lsw_tb_weekendworkrequests",
                                          "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                                          "item/lsw_approvalstatus": "Rejected",
                                          "item/lsw_currentstage": 3,
                                          "item/lsw_stage3result": "Rejected",
                                          "item/lsw_processedby": "{{STAGE3_EMAIL}}",
                                          "item/lsw_rejectionreason": "@coalesce(first(outputs('Approval3')?['body/responses'])?['comments'],'')"
                                        },
                                        "authentication": "@parameters('$authentication')"
                                      },
                                      "runAfter": {}
                                    },
                                    "EmailRejectedStage3": {
                                      "type": "OpenApiConnection",
                                      "inputs": {
                                        "host": {
                                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                          "connectionName": "shared_office365",
                                          "operationId": "SendEmailV2"
                                        },
                                        "parameters": {
                                          "emailMessage/To": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                                          "emailMessage/Subject": "[주말근무 신청] 3차 반려",
                                          "emailMessage/Body": "<p>3차 승인에서 반려되었습니다.</p><p>사유: @{coalesce(first(outputs('Approval3')?['body/responses'])?['comments'],'')}</p>"
                                        },
                                        "authentication": "@parameters('$authentication')"
                                      },
                                      "runAfter": {
                                        "RejectStage3": [
                                          "Succeeded"
                                        ]
                                      }
                                    }
                                  }
                                },
                                "runAfter": {
                                  "Approval3": [
                                    "Succeeded"
                                  ]
                                }
                              }
                            },
                            "else": {
                              "actions": {
                                "RejectStage2": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                      "connectionName": "shared_commondataserviceforapps",
                                      "operationId": "UpdateRecord"
                                    },
                                    "parameters": {
                                      "entityName": "lsw_tb_weekendworkrequests",
                                      "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                                      "item/lsw_approvalstatus": "Rejected",
                                      "item/lsw_currentstage": 2,
                                      "item/lsw_stage2result": "Rejected",
                                      "item/lsw_processedby": "{{STAGE2_EMAIL}}",
                                      "item/lsw_rejectionreason": "@coalesce(first(outputs('Approval2')?['body/responses'])?['comments'],'')"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  },
                                  "runAfter": {}
                                },
                                "EmailRejectedStage2": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                      "connectionName": "shared_office365",
                                      "operationId": "SendEmailV2"
                                    },
                                    "parameters": {
                                      "emailMessage/To": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                                      "emailMessage/Subject": "[주말근무 신청] 2차 반려",
                                      "emailMessage/Body": "<p>2차 승인에서 반려되었습니다.</p><p>사유: @{coalesce(first(outputs('Approval2')?['body/responses'])?['comments'],'')}</p>"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  },
                                  "runAfter": {
                                    "RejectStage2": [
                                      "Succeeded"
                                    ]
                                  }
                                }
                              }
                            },
                            "runAfter": {
                              "Approval2": [
                                "Succeeded"
                              ]
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "RejectStage1": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "UpdateRecord"
                                },
                                "parameters": {
                                  "entityName": "lsw_tb_weekendworkrequests",
                                  "recordId": "@triggerBody()?['lsw_tb_weekendworkrequestid']",
                                  "item/lsw_approvalstatus": "Rejected",
                                  "item/lsw_currentstage": 1,
                                  "item/lsw_stage1result": "Rejected",
                                  "item/lsw_processedby": "@outputs('LeaderEmail')",
                                  "item/lsw_rejectionreason": "@coalesce(first(outputs('Approval1')?['body/responses'])?['comments'],'')"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            },
                            "EmailRejectedStage1": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                                  "connectionName": "shared_office365",
                                  "operationId": "SendEmailV2"
                                },
                                "parameters": {
                                  "emailMessage/To": "@outputs('GetEmployee')?['body/lsw_emp_email']",
                                  "emailMessage/Subject": "[주말근무 신청] 1차 반려",
                                  "emailMessage/Body": "<p>1차 승인에서 반려되었습니다.</p><p>사유: @{coalesce(first(outputs('Approval1')?['body/responses'])?['comments'],'')}</p>"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {
                                "RejectStage1": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        },
                        "runAfter": {
                          "Approval1": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "LeaderEmail": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "SetRoutingErrorLeader": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "connectionName": "shared_commondataserviceforapps",
